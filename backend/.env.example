# AI-RMMS Supabase project (eu-west-1, dedicated database: ai-rmms)
# Copy to backend/.env and fill in real values. Never commit .env.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional labels (for health / system/config reporting)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_REGION=eu-west-1

# Optional — backend-only privileged jobs (ingestion backfill, etc.)
# Do NOT put this in the frontend or commit it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (generation + embeddings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
